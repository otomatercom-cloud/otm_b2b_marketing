<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_otm_b2b_telegram_template_list" model="ir.ui.view">
        <field name="name">otm.b2b.telegram.template.list</field>
        <field name="model">otm.b2b.telegram.template</field>
        <field name="arch" type="xml">
            <list string="Telegram Templates">
                <field name="code"/>
                <field name="name"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_otm_b2b_telegram_template_form" model="ir.ui.view">
        <field name="name">otm.b2b.telegram.template.form</field>
        <field name="model">otm.b2b.telegram.template</field>
        <field name="arch" type="xml">
            <form string="Telegram Template">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="placeholders_help" readonly="1"/>
                        <field name="active"/>
                    </group>
                    <field name="body" placeholder="Use the placeholders shown above, e.g. {institution}"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_otm_b2b_telegram_template" model="ir.actions.act_window">
        <field name="name">Telegram Templates</field>
        <field name="res_model">otm.b2b.telegram.template</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
