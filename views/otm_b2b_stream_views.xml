<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_otm_b2b_stream_list" model="ir.ui.view">
        <field name="name">otm.b2b.stream.list</field>
        <field name="model">otm.b2b.stream</field>
        <field name="arch" type="xml">
            <list string="Streams" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_otm_b2b_stream" model="ir.actions.act_window">
        <field name="name">Streams</field>
        <field name="res_model">otm.b2b.stream</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
