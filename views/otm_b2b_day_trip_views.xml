<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== Day Trip ===== -->
    <record id="view_otm_b2b_day_trip_form" model="ir.ui.view">
        <field name="name">otm.b2b.day.trip.form</field>
        <field name="model">otm.b2b.day.trip</field>
        <field name="arch" type="xml">
            <form string="Day Trip">
                <header>
                    <button name="action_open_add_stop" type="object" string="Add Stop"
                            class="btn-primary" icon="fa-map-marker" invisible="state != 'in_progress'"/>
                    <button name="action_open_finish" type="object" string="Return Home &amp; Complete Day"
                            class="btn-success" icon="fa-home" invisible="state != 'in_progress'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'completed'"
                            groups="otm_b2b_marketing.group_otm_b2b_marketing_manager"/>
                    <button name="action_reopen" type="object" string="Reopen"
                            invisible="state == 'in_progress'"
                            groups="otm_b2b_marketing.group_otm_b2b_marketing_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="in_progress,completed,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Trip">
                            <field name="user_id" readonly="1"/>
                            <field name="trip_date" readonly="state != 'in_progress'"/>
                            <field name="start_meter" readonly="state != 'in_progress'"/>
                            <field name="end_meter"/>
                            <field name="notes"/>
                        </group>
                        <group string="Totals">
                            <field name="total_km"/>
                            <field name="visit_count"/>
                            <field name="stop_count"/>
                            <field name="rate_per_km"
                                   readonly="not context.get('allow_rate_edit') and state != 'in_progress'"/>
                            <field name="amount" widget="monetary" class="fw-bold"/>
                            <field name="approved_by_id" invisible="not approved_by_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="portal_url" widget="url" readonly="1" string="Mobile link"
                                   invisible="not portal_url or state != 'in_progress'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Stops" name="stops">
                            <field name="line_ids" readonly="state != 'in_progress'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="line_type"/>
                                    <field name="visit_plan_id" optional="hide"/>
                                    <field name="institution_id" options="{'no_create': True}"/>
                                    <field name="location_name"/>
                                    <field name="entry_mode"/>
                                    <field name="meter_reading" readonly="entry_mode != 'meter'"/>
                                    <field name="manual_km" readonly="entry_mode != 'km'"/>
                                    <field name="km" sum="Total KM"/>
                                    <field name="meter_after" optional="show"/>
                                    <field name="time" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_otm_b2b_day_trip_list" model="ir.ui.view">
        <field name="name">otm.b2b.day.trip.list</field>
        <field name="model">otm.b2b.day.trip</field>
        <field name="arch" type="xml">
            <list string="Day Trips" js_class="otm_colsearch_list"
                  decoration-success="state == 'approved'" decoration-info="state == 'in_progress'">
                <field name="trip_date"/>
                <field name="user_id"/>
                <field name="start_meter" optional="hide"/>
                <field name="end_meter" optional="hide"/>
                <field name="visit_count" sum="Visits"/>
                <field name="total_km" sum="Total KM"/>
                <field name="rate_per_km" optional="show"/>
                <field name="amount" sum="Total Amount"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_otm_b2b_day_trip_pivot" model="ir.ui.view">
        <field name="name">otm.b2b.day.trip.pivot</field>
        <field name="model">otm.b2b.day.trip</field>
        <field name="arch" type="xml">
            <pivot string="Travel Report">
                <field name="user_id" type="row"/>
                <field name="trip_date" interval="month" type="col"/>
                <field name="total_km" type="measure"/>
                <field name="visit_count" type="measure"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_otm_b2b_day_trip_search" model="ir.ui.view">
        <field name="name">otm.b2b.day.trip.search</field>
        <field name="model">otm.b2b.day.trip</field>
        <field name="arch" type="xml">
            <search string="Search Day Trips">
                <field name="user_id"/>
                <field name="trip_date"/>
                <field name="state"/>
                <filter string="Today" name="filter_today"
                        domain="[('trip_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="filter_this_month"
                        domain="[('trip_date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <filter string="My Trips" name="filter_mine" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="On Trip" name="filter_in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completed" name="filter_completed" domain="[('state', '=', 'completed')]"/>
                <filter string="Approved" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <group>
                    <filter string="Executive" name="groupby_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Date" name="groupby_date" context="{'group_by': 'trip_date:day'}"/>
                    <filter string="Month" name="groupby_month" context="{'group_by': 'trip_date:month'}"/>
                    <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_otm_b2b_day_trip" model="ir.actions.act_window">
        <field name="name">Day Trips (KM)</field>
        <field name="res_model">otm.b2b.day.trip</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="context">{'allow_rate_edit': True}</field>
        <field name="help">Press "Start Day Trip" from the menu when you leave home, add each stop with its meter reading, and finish when you reach home.</field>
    </record>

    <!-- ===== Wizards ===== -->
    <record id="view_otm_b2b_day_trip_start_wizard_form" model="ir.ui.view">
        <field name="name">otm.b2b.day.trip.start.wizard.form</field>
        <field name="model">otm.b2b.day.trip.start.wizard</field>
        <field name="arch" type="xml">
            <form string="Start Day Trip">
                <group>
                    <field name="start_meter"/>
                    <field name="rate_per_km"/>
                    <field name="notes"/>
                </group>
                <footer>
                    <button name="action_start" type="object" string="Start Trip" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_otm_b2b_day_trip_start_wizard" model="ir.actions.act_window">
        <field name="name">Start Day Trip</field>
        <field name="res_model">otm.b2b.day.trip.start.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_otm_b2b_day_trip_stop_wizard_form" model="ir.ui.view">
        <field name="name">otm.b2b.day.trip.stop.wizard.form</field>
        <field name="model">otm.b2b.day.trip.stop.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Stop">
                <field name="trip_id" invisible="1"/>
                <group>
                    <field name="last_meter"/>
                    <field name="line_type" widget="radio" options="{'horizontal': true}"/>
                    <field name="visit_plan_id" invisible="line_type != 'visit'"
                           domain="[('user_id', '=', uid), ('state', '!=', 'cancelled')]"
                           options="{'no_create': True}"/>
                    <field name="institution_id" invisible="line_type != 'visit'" options="{'no_create': True}"/>
                    <field name="location_name"/>
                    <field name="entry_mode" widget="radio" options="{'horizontal': true}"/>
                    <field name="meter_reading" invisible="entry_mode != 'meter'"/>
                    <field name="manual_km" invisible="entry_mode != 'km'"/>
                </group>
                <footer>
                    <button name="action_add" type="object" string="Add Stop" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_otm_b2b_day_trip_finish_wizard_form" model="ir.ui.view">
        <field name="name">otm.b2b.day.trip.finish.wizard.form</field>
        <field name="model">otm.b2b.day.trip.finish.wizard</field>
        <field name="arch" type="xml">
            <form string="Return Home">
                <field name="trip_id" invisible="1"/>
                <group>
                    <field name="last_meter"/>
                    <field name="entry_mode" widget="radio" options="{'horizontal': true}"/>
                    <field name="meter_reading" invisible="entry_mode != 'meter'"/>
                    <field name="manual_km" invisible="entry_mode != 'km'"/>
                </group>
                <footer>
                    <button name="action_finish" type="object" string="Complete Day" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_otm_b2b_travel_settings_wizard_form" model="ir.ui.view">
        <field name="name">otm.b2b.travel.settings.wizard.form</field>
        <field name="model">otm.b2b.travel.settings.wizard</field>
        <field name="arch" type="xml">
            <form string="Travel Settings">
                <group>
                    <field name="rate_per_km"/>
                </group>
                <div class="text-muted">
                    New trips use this amount per km. Trips already started or completed keep the rate
                    they started with (Managers can still adjust a trip's rate on the trip itself).
                </div>
                <footer>
                    <button name="action_save" type="object" string="Save" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_otm_b2b_travel_settings_wizard" model="ir.actions.act_window">
        <field name="name">Travel Settings</field>
        <field name="res_model">otm.b2b.travel.settings.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
