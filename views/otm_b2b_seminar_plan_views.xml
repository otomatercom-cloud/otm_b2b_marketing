<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_otm_b2b_seminar_plan_form" model="ir.ui.view">
        <field name="name">otm.b2b.seminar.plan.form</field>
        <field name="model">otm.b2b.seminar.plan</field>
        <field name="arch" type="xml">
            <form string="Seminar Plan">
                <header>
                    <button name="action_confirm_plan" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <!-- No backend "Check In" button here on purpose - see
                         otm_b2b_visit_plan_views.xml for why: only the Dashboard
                         captures GPS location on check-in. -->
                    <button name="action_open_complete_wizard" type="object" string="Complete Seminar"
                            class="btn-primary" invisible="state not in ('draft', 'planned', 'in_progress')"/>
                    <button name="action_cancel_plan" type="object" string="Cancel"
                            invisible="state in ('completed', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,planned,in_progress,completed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="institution_id" string="College / Institution" options="{'no_create': True}"/>
                            <field name="seminar_date"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="seminar_id" readonly="1" invisible="not seminar_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_otm_b2b_seminar_plan_list" model="ir.ui.view">
        <field name="name">otm.b2b.seminar.plan.list</field>
        <field name="model">otm.b2b.seminar.plan</field>
        <field name="arch" type="xml">
            <list string="Seminar Plans" decoration-info="state == 'draft'"
                  decoration-warning="state == 'in_progress'"
                  decoration-success="state == 'completed'" decoration-muted="state == 'cancelled'">
                <field name="seminar_date"/>
                <field name="institution_id"/>
                <field name="user_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_otm_b2b_seminar_plan_search" model="ir.ui.view">
        <field name="name">otm.b2b.seminar.plan.search</field>
        <field name="model">otm.b2b.seminar.plan</field>
        <field name="arch" type="xml">
            <search string="Search Seminar Plans">
                <field name="institution_id"/>
                <field name="user_id"/>
                <filter string="Today" name="filter_today"
                        domain="[('seminar_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Upcoming" name="filter_upcoming"
                        domain="[('seminar_date', '&gt;=', context_today().strftime('%Y-%m-%d')), ('state', '=', 'planned')]"/>
                <filter string="My Plans" name="filter_mine" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Planned" name="filter_planned" domain="[('state', '=', 'planned')]"/>
                <filter string="Checked In" name="filter_in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completed" name="filter_completed" domain="[('state', '=', 'completed')]"/>
                <group>
                    <filter string="Assigned To" name="groupby_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                    <filter string="Seminar Date" name="groupby_date" context="{'group_by': 'seminar_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_otm_b2b_seminar_plan" model="ir.actions.act_window">
        <field name="name">Seminar Booking</field>
        <field name="res_model">otm.b2b.seminar.plan</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_mine': 1, 'search_default_filter_upcoming': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">Book your next seminar</p>
        </field>
    </record>

</odoo>
