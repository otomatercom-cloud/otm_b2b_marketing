<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_otm_b2b_seminar_category_list" model="ir.ui.view">
        <field name="name">otm.b2b.seminar.category.list</field>
        <field name="model">otm.b2b.seminar.category</field>
        <field name="arch" type="xml">
            <list string="Seminar Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_otm_b2b_seminar_category" model="ir.actions.act_window">
        <field name="name">Seminar Categories</field>
        <field name="res_model">otm.b2b.seminar.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
