<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="otm_b2b_marketing.Dashboard">
        <div class="o_otm_b2b_dashboard p-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <div>
                    <h2 class="mb-0">B2B Marketing</h2>
                    <p class="o_otm_b2b_org_label">Logic School Of Management</p>
                </div>
                <div t-if="!state.loading">
                    <button t-if="state.telegramConnected"
                            class="o_otm_b2b_telegram_badge o_otm_b2b_telegram_connected"
                            t-on-click="disconnectTelegram" title="Click to disconnect">
                        <i class="fa fa-paper-plane"/> Telegram connected
                    </button>
                    <button t-else="" class="o_otm_b2b_telegram_badge o_otm_b2b_telegram_connect"
                            t-on-click="connectTelegram">
                        <i class="fa fa-paper-plane"/> Connect Telegram
                    </button>
                </div>
            </div>
            <div class="d-flex justify-content-between align-items-center flex-wrap" t-if="!state.loading">
                <p class="o_otm_b2b_scope_label mb-0">
                    <t t-if="state.isManager and state.viewingOther">Showing data for <t t-esc="state.viewingExecutiveName"/></t>
                    <t t-elif="state.isManager">Showing all Marketing data</t>
                    <t t-else="">Showing your data, <t t-esc="state.userName"/></t>
                </p>
                <div t-if="state.isManager and state.availableExecutives.length" class="o_otm_b2b_exec_filter">
                    <select class="form-select form-select-sm" t-on-change="onExecutiveFilterChange">
                        <option value="">All Marketing Executives</option>
                        <option t-foreach="state.availableExecutives" t-as="exec" t-key="exec.id"
                                t-att-value="exec.id" t-att-selected="state.selectedExecutiveId === exec.id">
                            <t t-esc="exec.name"/>
                        </option>
                    </select>
                </div>
            </div>

            <div t-if="state.loading" class="text-muted mt-3">Loading dashboard...</div>

            <t t-if="!state.loading">
                <div class="o_otm_b2b_kpi_row mt-3">
                    <div class="o_otm_b2b_kpi_card" t-on-click="openTodayVisits">
                        <div class="o_otm_b2b_kpi_top">
                            <span class="o_otm_b2b_kpi_label">Today's visits</span>
                            <i class="fa fa-map-marker o_otm_b2b_kpi_icon"/>
                        </div>
                        <div class="o_otm_b2b_kpi_value"><t t-esc="state.cards.today_visits"/></div>
                    </div>
                    <div class="o_otm_b2b_kpi_card" t-on-click="openUpcomingVisits">
                        <div class="o_otm_b2b_kpi_top">
                            <span class="o_otm_b2b_kpi_label">Upcoming visits</span>
                            <i class="fa fa-calendar o_otm_b2b_kpi_icon"/>
                        </div>
                        <div class="o_otm_b2b_kpi_value"><t t-esc="state.cards.upcoming_visits"/></div>
                    </div>
                    <div class="o_otm_b2b_kpi_card" t-on-click="() => this.openFiltered('otm.b2b.visit.plan', 'Completed Visits', [['state', '=', 'completed']])">
                        <div class="o_otm_b2b_kpi_top">
                            <span class="o_otm_b2b_kpi_label">Completed visits</span>
                            <i class="fa fa-check-circle o_otm_b2b_kpi_icon"/>
                        </div>
                        <div class="o_otm_b2b_kpi_value"><t t-esc="state.cards.completed_visits"/></div>
                    </div>
                    <div class="o_otm_b2b_kpi_card" t-on-click="() => this.openFiltered('otm.b2b.visit.plan', 'Pending Visits', [['state', 'in', ['draft', 'planned', 'in_progress']]])">
                        <div class="o_otm_b2b_kpi_top">
                            <span class="o_otm_b2b_kpi_label">Pending visits</span>
                            <i class="fa fa-hourglass-half o_otm_b2b_kpi_icon"/>
                        </div>
                        <div class="o_otm_b2b_kpi_value"><t t-esc="state.cards.pending_visits"/></div>
                    </div>
                    <div class="o_otm_b2b_kpi_card" t-on-click="() => this.openFiltered('otm.b2b.visit.record', 'Live Visits', [['checkin_time', '!=', false], ['checkout_time', '=', false]])">
                        <div class="o_otm_b2b_kpi_top">
                            <span class="o_otm_b2b_kpi_label">Live now</span>
                            <i class="fa fa-circle o_otm_b2b_kpi_icon" style="color:#dc3545;"/>
                        </div>
                        <div class="o_otm_b2b_kpi_value"><t t-esc="state.cards.live_visits"/></div>
                    </div>
                    <div class="o_otm_b2b_kpi_card" t-on-click="() => this.openFiltered('otm.b2b.visit.record', 'Completed Today', [], {search_default_filter_today: 1, search_default_filter_completed: 1})">
                        <div class="o_otm_b2b_kpi_top">
                            <span class="o_otm_b2b_kpi_label">Completed today</span>
                            <i class="fa fa-check-circle-o o_otm_b2b_kpi_icon"/>
                        </div>
                        <div class="o_otm_b2b_kpi_value"><t t-esc="state.cards.today_completed"/></div>
                    </div>
                    <div class="o_otm_b2b_kpi_card" t-on-click="openInstitutions">
                        <div class="o_otm_b2b_kpi_top">
                            <span class="o_otm_b2b_kpi_label">Total institutions</span>
                            <i class="fa fa-university o_otm_b2b_kpi_icon"/>
                        </div>
                        <div class="o_otm_b2b_kpi_value"><t t-esc="state.cards.total_institutions"/></div>
                    </div>
                    <div class="o_otm_b2b_kpi_card" t-on-click="openHighPriorityInstitutions">
                        <div class="o_otm_b2b_kpi_top">
                            <span class="o_otm_b2b_kpi_label">High Priority</span>
                            <i class="fa fa-star o_otm_b2b_kpi_icon" style="color:#f1c40f;"/>
                        </div>
                        <div class="o_otm_b2b_kpi_value"><t t-esc="state.cards.high_priority_institutions"/></div>
                    </div>
                    <div class="o_otm_b2b_kpi_card" t-on-click="openLeads">
                        <div class="o_otm_b2b_kpi_top">
                            <span class="o_otm_b2b_kpi_label">Leads collected</span>
                            <i class="fa fa-users o_otm_b2b_kpi_icon"/>
                        </div>
                        <div class="o_otm_b2b_kpi_value"><t t-esc="state.cards.leads_collected"/></div>
                    </div>
                    <div class="o_otm_b2b_kpi_card" t-on-click="openSeminarsConducted">
                        <div class="o_otm_b2b_kpi_top">
                            <span class="o_otm_b2b_kpi_label">Seminars conducted</span>
                            <i class="fa fa-graduation-cap o_otm_b2b_kpi_icon"/>
                        </div>
                        <div class="o_otm_b2b_kpi_value"><t t-esc="state.cards.seminars_conducted"/></div>
                    </div>
                    <div class="o_otm_b2b_kpi_card" t-on-click="openMou">
                        <div class="o_otm_b2b_kpi_top">
                            <span class="o_otm_b2b_kpi_label">MOU signed</span>
                            <i class="fa fa-file-text-o o_otm_b2b_kpi_icon"/>
                        </div>
                        <div class="o_otm_b2b_kpi_value"><t t-esc="state.cards.mou_signed"/></div>
                    </div>
                </div>

                <div class="o_otm_b2b_panel mt-4" t-if="state.isManager and !state.viewingOther">
                    <h4>Territory Manager Performance</h4>
                    <div class="o_otm_b2b_table_wrap">
                        <table class="o_otm_b2b_perf_table">
                            <thead>
                                <tr>
                                    <th>Manager</th>
                                    <th class="text-end">Today</th>
                                    <th class="text-end">This Week</th>
                                    <th class="text-end">This Month</th>
                                    <th class="text-end">Seminars</th>
                                    <th class="text-end">Proposals Sent</th>
                                    <th class="text-end">Approved</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="state.territoryPerformance" t-as="row" t-key="row_index">
                                    <td><t t-esc="row.name"/></td>
                                    <td class="text-end"><t t-esc="row.visits_today"/></td>
                                    <td class="text-end"><t t-esc="row.visits_week"/></td>
                                    <td class="text-end"><t t-esc="row.visits_month"/></td>
                                    <td class="text-end"><t t-esc="row.seminars"/></td>
                                    <td class="text-end"><t t-esc="row.mou_proposal_sent"/></td>
                                    <td class="text-end"><t t-esc="row.mou_approved"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <p t-if="!state.territoryPerformance.length" class="text-muted mb-0">No territory managers with assigned institutions yet.</p>
                </div>

                <div class="o_otm_b2b_panel mt-3" t-if="state.isManager and !state.viewingOther">
                    <h4>All Planned Seminars</h4>
                    <div class="o_otm_b2b_table_wrap">
                        <table class="o_otm_b2b_perf_table">
                            <thead>
                                <tr>
                                    <th>Institution</th>
                                    <th>Officer</th>
                                    <th>District</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="state.allSeminarsPlanned" t-as="row" t-key="row_index"
                                    class="o_otm_b2b_clickable_row" t-on-click="() => this.openSeminarPlanRecord(row.plan_id)">
                                    <td><t t-esc="row.institution"/></td>
                                    <td><t t-esc="row.executive"/></td>
                                    <td><t t-esc="row.district"/></td>
                                    <td><t t-esc="row.seminar_date"/></td>
                                    <td><t t-esc="row.state"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <p t-if="!state.allSeminarsPlanned.length" class="text-muted mb-0">No seminars planned across the team yet.</p>
                </div>

                <div class="o_otm_b2b_charts_row mt-4">
                    <div class="o_otm_b2b_panel">
                        <h4>Institution type distribution</h4>
                        <div class="o_otm_b2b_bar_list">
                            <div class="o_otm_b2b_bar_row" t-foreach="state.byType" t-as="row" t-key="row.label">
                                <div class="o_otm_b2b_bar_head">
                                    <span><t t-esc="row.label"/></span>
                                    <span class="text-muted"><t t-esc="row.count"/></span>
                                </div>
                                <div class="o_otm_b2b_bar_track">
                                    <div class="o_otm_b2b_bar_fill o_otm_b2b_bar_accent"
                                         t-attf-style="width: {{row.pct}}%"/>
                                </div>
                            </div>
                            <p t-if="!state.byType.length" class="text-muted mb-0">No data yet.</p>
                        </div>
                    </div>
                    <div class="o_otm_b2b_panel">
                        <h4>District wise institutions</h4>
                        <div class="o_otm_b2b_bar_list">
                            <div class="o_otm_b2b_bar_row" t-foreach="state.byDistrict" t-as="row" t-key="row.label">
                                <div class="o_otm_b2b_bar_head">
                                    <span><t t-esc="row.label"/></span>
                                    <span class="text-muted"><t t-esc="row.count"/></span>
                                </div>
                                <div class="o_otm_b2b_bar_track">
                                    <div class="o_otm_b2b_bar_fill o_otm_b2b_bar_success"
                                         t-attf-style="width: {{row.pct}}%"/>
                                </div>
                            </div>
                            <p t-if="!state.byDistrict.length" class="text-muted mb-0">No data yet.</p>
                        </div>
                    </div>
                </div>

                <div class="o_otm_b2b_panel mt-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h4 class="mb-0">My Institutions</h4>
                        <a href="#" class="o_otm_b2b_view_all" t-on-click.prevent="openInstitutions">View all</a>
                    </div>
                    <div class="o_otm_b2b_visit_row o_otm_b2b_row_clickable" t-foreach="state.myInstitutions" t-as="inst" t-key="inst.id"
                         t-on-click="() => this.openInstitutionRecord(inst.id)">
                        <div class="o_otm_b2b_visit_avatar" t-att-class="inst.live_visit_id ? 'o_otm_b2b_visit_avatar_live' : ''">
                            <t t-esc="inst.name ? inst.name.slice(0,2).toUpperCase() : '--'"/>
                        </div>
                        <div class="o_otm_b2b_visit_info">
                            <div class="o_otm_b2b_visit_name"><t t-esc="inst.name"/></div>
                            <div class="o_otm_b2b_visit_meta">
                                <t t-if="inst.tier"><t t-esc="inst.tier"/></t>
                                <t t-if="inst.district"> · <t t-esc="inst.district"/></t>
                            </div>
                        </div>
                        <button t-if="!state.viewingOther and !inst.live_visit_id" class="o_otm_b2b_checkin_btn"
                                t-on-click="(ev) => { ev.stopPropagation(); this.checkIn(inst.plan_id); }">Check In</button>
                        <button t-elif="!state.viewingOther" class="o_otm_b2b_checkin_btn"
                                t-on-click="(ev) => { ev.stopPropagation(); this.checkOut({ id: inst.live_visit_id, portal_url: inst.live_visit_portal_url, institution: inst.name }); }">
                            Check Out
                        </button>
                    </div>
                    <p t-if="!state.myInstitutions.length" class="text-muted mb-0">No institutions assigned to you yet.</p>
                </div>

                <div class="o_otm_b2b_panel mt-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h4 class="mb-0">My Seminars</h4>
                        <a href="#" class="o_otm_b2b_view_all" t-on-click.prevent="openSeminars">View all</a>
                    </div>
                    <div class="o_otm_b2b_visit_row" t-foreach="state.mySeminars" t-as="sem" t-key="sem.id">
                        <div class="o_otm_b2b_visit_avatar" t-att-class="sem.live_seminar_id ? 'o_otm_b2b_visit_avatar_live' : ''">
                            <t t-esc="sem.name ? sem.name.slice(0,2).toUpperCase() : '--'"/>
                        </div>
                        <div class="o_otm_b2b_visit_info">
                            <div class="o_otm_b2b_visit_name"><t t-esc="sem.name"/></div>
                            <div class="o_otm_b2b_visit_meta">
                                <t t-if="sem.tier"><t t-esc="sem.tier"/></t>
                                <t t-if="sem.district"> · <t t-esc="sem.district"/></t>
                            </div>
                        </div>
                        <button t-if="!state.viewingOther and !sem.live_seminar_id" class="o_otm_b2b_checkin_btn"
                                t-on-click="() => this.checkInSeminar(sem.plan_id)">Check In</button>
                        <button t-elif="!state.viewingOther" class="o_otm_b2b_checkin_btn"
                                t-on-click="() => this.checkOutSeminar({ id: sem.live_seminar_id, portal_url: sem.live_seminar_portal_url, institution: sem.name })">
                            Check Out
                        </button>
                    </div>
                    <p t-if="!state.mySeminars.length" class="text-muted mb-0">No seminars booked for today.</p>
                </div>

                <div class="o_otm_b2b_panel mt-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h4 class="mb-0">
                            <span class="o_otm_b2b_live_dot"/> Live visits
                        </h4>
                    </div>
                    <div class="o_otm_b2b_visit_row o_otm_b2b_row_clickable" t-foreach="state.liveVisits" t-as="visit" t-key="visit_index"
                         t-on-click="() => this.openInstitutionRecord(visit.institution_id)">
                        <div class="o_otm_b2b_visit_avatar o_otm_b2b_visit_avatar_live">
                            <t t-esc="visit.executive ? visit.executive.slice(0,2).toUpperCase() : '--'"/>
                        </div>
                        <div class="o_otm_b2b_visit_info">
                            <div class="o_otm_b2b_visit_name"><t t-esc="visit.institution"/></div>
                            <div class="o_otm_b2b_visit_meta">
                                <t t-esc="visit.executive"/>
                                <t t-if="visit.district"> · <t t-esc="visit.district"/></t>
                            </div>
                        </div>
                        <span class="o_otm_b2b_visit_date">Since <t t-esc="visit.checkin_time"/></span>
                        <button t-if="!state.viewingOther" class="o_otm_b2b_checkin_btn" t-on-click="(ev) => { ev.stopPropagation(); this.checkOut(visit); }">Check Out</button>
                    </div>
                    <p t-if="!state.liveVisits.length" class="text-muted mb-0">No one is checked in right now.</p>
                </div>

                <div class="o_otm_b2b_panel mt-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h4 class="mb-0">Today's completed visits</h4>
                        <a href="#" class="o_otm_b2b_view_all" t-on-click.prevent="openTodayCompletedVisits">View all</a>
                    </div>
                    <div class="o_otm_b2b_visit_row" t-foreach="state.todayCompleted" t-as="visit" t-key="visit_index">
                        <div class="o_otm_b2b_visit_avatar o_otm_b2b_visit_avatar_done">
                            <t t-esc="visit.executive ? visit.executive.slice(0,2).toUpperCase() : '--'"/>
                        </div>
                        <div class="o_otm_b2b_visit_info">
                            <div class="o_otm_b2b_visit_name"><t t-esc="visit.institution"/></div>
                            <div class="o_otm_b2b_visit_meta">
                                <t t-esc="visit.executive"/>
                                <t t-if="visit.district"> · <t t-esc="visit.district"/></t>
                            </div>
                        </div>
                        <span class="o_otm_b2b_visit_date" t-if="visit.marketing_activity"><t t-esc="visit.marketing_activity"/></span>
                        <button class="o_otm_b2b_checkin_btn o_otm_b2b_checkin_btn_ghost"
                                t-on-click="() => this.openVisitRecord(visit.id)">View</button>
                    </div>
                    <p t-if="!state.todayCompleted.length" class="text-muted mb-0">No visits completed yet today.</p>
                </div>

                <div class="o_otm_b2b_panel mt-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h4 class="mb-0">Upcoming visits</h4>
                        <a href="#" class="o_otm_b2b_view_all" t-on-click.prevent="openUpcomingVisits">View all</a>
                    </div>
                    <div class="o_otm_b2b_visit_row" t-foreach="state.upcomingVisits" t-as="visit" t-key="visit_index">
                        <div class="o_otm_b2b_visit_avatar">
                            <t t-esc="visit.executive ? visit.executive.slice(0,2).toUpperCase() : '--'"/>
                        </div>
                        <div class="o_otm_b2b_visit_info">
                            <div class="o_otm_b2b_visit_name"><t t-esc="visit.institution"/></div>
                            <div class="o_otm_b2b_visit_meta">
                                <t t-esc="visit.executive"/>
                                <t t-if="visit.district"> · <t t-esc="visit.district"/></t>
                            </div>
                        </div>
                        <span class="o_otm_b2b_visit_date"><t t-esc="visit.visit_date"/></span>
                        <button t-if="!state.viewingOther" class="o_otm_b2b_checkin_btn" t-on-click="() => this.checkIn(visit.id)">Check In</button>
                    </div>
                    <p t-if="!state.upcomingVisits.length" class="text-muted mb-0">No upcoming visits planned.</p>
                </div>
            </t>
        </div>
    </t>

</templates>
