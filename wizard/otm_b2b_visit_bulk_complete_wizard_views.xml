<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_otm_b2b_visit_bulk_complete_wizard_form" model="ir.ui.view">
        <field name="name">otm.b2b.visit.bulk.complete.wizard.form</field>
        <field name="model">otm.b2b.visit.bulk.complete.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Complete Visits">
                <group>
                    <field name="visit_ids" widget="many2many_tags" readonly="1"/>
                    <field name="marketing_activity_type_id"/>
                    <field name="remarks" placeholder="Applied to every selected visit - leave blank to keep each one's existing remarks"/>
                </group>
                <footer>
                    <button name="action_complete" type="object" string="Mark All Completed" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_otm_b2b_visit_bulk_complete_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Complete Visits</field>
        <field name="res_model">otm.b2b.visit.bulk.complete.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_otm_b2b_visit_record"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
